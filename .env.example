# Set these in Vercel -> Project -> Settings -> Environment Variables. Never commit real values.

# Sign-ups go straight to Chakra when CHAKRA_API_KEY and CHAKRA_WINTER_CAMPAIGN_ID are both set.
CHAKRA_API_KEY=
CHAKRA_WINTER_CAMPAIGN_ID=
CHAKRA_ATTR_EVENT=
CHAKRA_ATTR_TRIAL=
CHAKRA_ATTR_SOURCE=

# Fallback, used only while the key above is missing: pass sign-ups to the main site's endpoint.
REGISTER_FORWARD_URL=https://ilmi.online/api/winter-register
