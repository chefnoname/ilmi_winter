# Set these in Vercel -> Project -> Settings -> Environment Variables. Never commit real values.

# Option 1 (default): pass sign-ups to the main site's endpoint, which holds the Chakra key.
REGISTER_FORWARD_URL=https://ilmi.online/api/winter-register

# Option 2: talk to Chakra directly from this project. If CHAKRA_API_KEY and
# CHAKRA_WINTER_CAMPAIGN_ID are both set, they are used instead of the forward.
CHAKRA_API_KEY=
CHAKRA_WINTER_CAMPAIGN_ID=
CHAKRA_ATTR_EVENT=
CHAKRA_ATTR_SOURCE=
