# Set these in Vercel -> Project -> Settings -> Environment Variables. Never commit real values.

# Sign-ups go straight to Chakra when CHAKRA_API_KEY and CHAKRA_WINTER_CAMPAIGN_ID are both set.
CHAKRA_API_KEY=
CHAKRA_WINTER_CAMPAIGN_ID=
# Optional: shorter copies of the campaign for sign-ups in the last 48 hours and the last 24 hours.
CHAKRA_WINTER_CAMPAIGN_ID_48H=
CHAKRA_WINTER_CAMPAIGN_ID_24H=
CHAKRA_ATTR_EVENT=
CHAKRA_ATTR_TRIAL=
CHAKRA_ATTR_SOURCE=

# Optional. Meta Conversions API token for "Ilmi Pixel 26/27" (Events Manager -> the pixel -> Settings ->
# Conversions API -> Generate access token). When set, each saved sign-up is also sent to Meta from the server.
META_CAPI_TOKEN=

# Fallback, used only while the key above is missing: pass sign-ups to the main site's endpoint.
REGISTER_FORWARD_URL=https://ilmi.online/api/winter-register
